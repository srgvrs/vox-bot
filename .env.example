# Dominios permitidos para /video (separados por coma; se aceptan subdominios)
ALLOWED_VIDEO_DOMAINS=youtube.com,youtu.be,instagram.com
# Minutos máximos de video para recomprimir; si dura más, se sube directo a un host
RECOMPRESS_MAX_MINUTES=3
# Reels de Instagram más largos que esto se descargan limitando a 480p (lado corto)
INSTAGRAM_LONG_REEL_SECONDS=60
# Segundos de espera por usuario entre usos de /video
VIDEO_COOLDOWN_SECONDS=30
# Altura máxima para videos que se subirán a un host externo (adjuntos usan MAX_VIDEO_HEIGHT)
HOST_VIDEO_HEIGHT=480
# Tope de tamaño (MB) para descargas destinadas a host externo
HOST_MAX_MB=35
# Emoji animado para el mensaje de estado de /video (formato <a:nombre:id>).
# Vacío = spinner braille.
STATUS_EMOJI=
